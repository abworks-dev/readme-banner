* text=auto eol=lf
*.svg text eol=lf
*.png binary
*.gif binary
*.gz binary

# Fixed-width drawing/mask grids intentionally retain blank cells and rows.
examples/image-to-ascii/project-art*.txt whitespace=-blank-at-eol,-blank-at-eof

# Upstream font notices must remain byte-identical to their pinned hashes.
examples/pixel-game-vfx/fonts/LICENSE-OFL.txt -text whitespace=-blank-at-eol
examples/pixel-game-vfx/fonts/LICENSES/** -text whitespace=-blank-at-eol
